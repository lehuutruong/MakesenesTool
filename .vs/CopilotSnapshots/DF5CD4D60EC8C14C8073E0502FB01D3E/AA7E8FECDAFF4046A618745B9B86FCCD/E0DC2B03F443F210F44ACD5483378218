<Application x:Class="MakesenesTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MakesenesTool.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Colours: the only place hex values are defined. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#185FA5"/>
            <SolidColorBrush x:Key="OkBrush" Color="#3B6D11"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#854F0B"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#A32D2D"/>
            <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#6B6B6B"/>
            <SolidColorBrush x:Key="DisabledBrush" Color="#DADADA"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#C8C8C8"/>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FAEEDA"/>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
            <local:EnumMatchConverter x:Key="EnumMatch"/>
            <local:StepStateBrushConverter x:Key="StepBrush"/>

            <!-- Radio button rendered as a bordered card (selected = accent border). -->
            <Style x:Key="ActionCard" TargetType="RadioButton">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="16">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- Blue filled button used for Next / Run. Greyed out when disabled. -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="28,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource DisabledBrush}"/>
                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
