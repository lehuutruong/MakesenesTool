/// <summary>Step 3: Running and Results. Runs the migration job and shows progress, log and summary.</summary>
public partial class Step3ViewModel : ObservableObject
{
    private const int MaxLogLines = 500;
    private readonly IReportExportService _reportExporter;
    private string? _reportPath;
    private string? _logFilePath;
    private readonly object _logFileLock = new();

    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(ProgressPercent))]
    private int _currentRow;

    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(ProgressPercent))]
    private int _totalRows;

    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(CanOpenReport))]
    private bool _isRunning;

    [ObservableProperty]
    private string _statusLabel = string.Empty;

    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(HasNotice))]
    private NoticeBannerViewModel? _noticeBanner;

    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(CanOpenReport))]
    private bool _reportReady;

    [ObservableProperty]
    private bool _isCompleted;

    [ObservableProperty]
    [NotifyPropertyChangedFor(nameof(PassedLabel))]
    [NotifyPropertyChangedFor(nameof(FailedLabel))]
    private RunMode _mode = RunMode.ValidateOnly;

    [ObservableProperty]
    private int _totalCount;

    [ObservableProperty]
    private int _passedCount;

    [ObservableProperty]
    private int _failedCount;

    /// <summary>Log lines, capped at 500.</summary>
    public ObservableCollection<LogLine> LogLines { get; } = [];

    /// <summary>Progress in percent of total rows.</summary>
    public double ProgressPercent => TotalRows == 0 ? 0 : CurrentRow * 100.0 / TotalRows;

    /// <summary>True when the report file has been written.</summary>
    public bool CanOpenReport => ReportReady;

    /// <summary>True when the warning banner is visible.</summary>
    public bool HasNotice => NoticeBanner is not null;

    /// <summary>Label of the "passed" card.</summary>
    public string PassedLabel => Mode == RunMode.ValidateOnly ? "Successful" : "Imported";

    /// <summary>Label of the "failed" card.</summary>
    public string FailedLabel => Mode == RunMode.ValidateOnly ? "Failed" : "Skipped";

    /// <param name="reportExporter">Writes the Excel error report.</param>
    public Step3ViewModel(IReportExportService reportExporter)
    {
        _reportExporter = reportExporter;
    }

    private async Task ExportReportsFromDbAsync(string dbPath, string outputFolder)
    {
        await Task.Run(() =>
        {
            var cs = $"Data Source={dbPath};Cache=Shared";
            using var conn = new Microsoft.Data.Sqlite.SqliteConnection(cs);
            conn.Open();

            // Optimize for read-only operations (export doesn't write)
            using (var cmd = conn.CreateCommand())
            {
                cmd.CommandText = "PRAGMA journal_mode = WAL; PRAGMA query_only = TRUE; PRAGMA busy_timeout = 10000;";
                cmd.ExecuteNonQuery();
            }

            var tables = new List<string>();
            using (var cmd = conn.CreateCommand())
            {
                cmd.CommandText = "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' AND name <> 'ProcessingSummaries' ORDER BY name;";
                using var reader = cmd.ExecuteReader();
                while (reader.Read())
                    tables.Add(reader.GetString(0));
            }

            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");

            foreach (var t in tables)
            {
                try
                {
                    // Get available columns
                    var available = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                    using (var info = conn.CreateCommand())
                    {
                        info.CommandText = $"PRAGMA table_info(\"{t}\");";
                        using var rinfo = info.ExecuteReader();
                        while (rinfo.Read())
                            available.Add(rinfo.GetString(1));
                    }

                    var desired = new[] { "SheetName", "Time", "Month", "Year", "Value", "SourceFile", "Status", "Message" };
                    var headers = desired.Where(h => available.Contains(h, StringComparer.OrdinalIgnoreCase)).ToList();
                    if (headers.Count == 0)
                        headers = available.ToList();

                    var selectList = string.Join(", ", headers.Select(h => "\"" + h + "\""));
                    var hasTime = available.Any(c => string.Equals(c, "Time", StringComparison.OrdinalIgnoreCase));
                    var orderBy = hasTime ? " ORDER BY \"Time\"" : string.Empty;

                    using var cmd = conn.CreateCommand();
                    cmd.CommandText = $"SELECT {selectList} FROM \"{t}\"{orderBy};";
                    using var reader = cmd.ExecuteReader();

                    using var workbook = new XLWorkbook();
                    var ws = workbook.Worksheets.Add(t);

                    // Write headers
                    for (int i = 0; i < headers.Count; i++)
                        ws.Cell(1, i + 1).SetValue(headers[i]);

                    // Write data rows
                    int row = 2;
                    while (reader.Read())
                    {
                        for (int c = 0; c < headers.Count; c++)
                        {
                            var cell = ws.Cell(row, c + 1);
                            var colName = headers[c];
                            var ord = reader.GetOrdinal(colName);
                            if (reader.IsDBNull(ord))
                            {
                                cell.SetValue(string.Empty);
                                continue;
                            }

                            var obj = reader.GetValue(ord);
                            if (obj is double d)
                                cell.SetValue(d);
                            else if (obj is int i)
                                cell.SetValue(i);
                            else if (obj is long l)
                                cell.SetValue(l);
                            else if (obj is DateTime dt)
                                cell.SetValue(dt);
                            else
                                cell.SetValue(obj?.ToString() ?? string.Empty);
                        }
                        row++;
                    }

                    // Save workbook
                    var fileName = Path.Combine(outputFolder, $"{t}_{timestamp}_report.xlsx");
                    workbook.SaveAs(fileName);
                    Log(LogLevel.Ok, $"Exported {t} ({row - 2} rows)");
                }
                catch (Exception ex)
                {
                    Log(LogLevel.Error, $"Failed to export {t}: {ex.Message}");
                }
            }

            conn.Close();
        });
    }

    /// <summary>Runs processors found in the provided sqlite DB. If validateOnly is true, runs validation; otherwise runs calculation.
    /// Updates progress and persists status messages. When finished sets ReportReady and opens output folder via OpenReport.</summary>
    public async Task RunProcessorsAsync(string dbPath, bool validateOnly, string outputFolder)
    {
        BeginRun(Mode);
        try
        {
            // Discover tables
            var tables = new List<string>();
            using (var conn = new Microsoft.Data.Sqlite.SqliteConnection($"Data Source={dbPath}"))
            {
                conn.Open();
                using var cmd = conn.CreateCommand();
                cmd.CommandText = "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';";
                using var reader = cmd.ExecuteReader();
                while (reader.Read())
                    tables.Add(reader.GetString(0));
                // compute total rows
                int total = 0;
                foreach (var t in tables)
                {
                    using var c2 = conn.CreateCommand();
                    c2.CommandText = $"SELECT COUNT(*) FROM \"{t}\";";
                    total += Convert.ToInt32(c2.ExecuteScalar());
                }
                try
                {
                    System.Windows.Application.Current.Dispatcher.Invoke(() => TotalRows = total);
                }
                catch
                {
                    TotalRows = total;
                }
                conn.Close();
            }

            CurrentRow = 0;
            StatusLabel = validateOnly ? "Validating data…" : "Calculating…";

            // Process tables sequentially for stability with per-table parallelism
            // Batch UI updates to reduce Dispatcher overhead
            var uiBatch = 100; // update UI every N rows

            for (int tIdx = 0; tIdx < tables.Count; tIdx++)
            {
                var t = tables[tIdx];
                Log(LogLevel.Info, $"Processing table {t} ({tIdx + 1}/{tables.Count})...");

                var processor = new SimpleMeasurementProcessor(dbPath, t);
                await processor.InitAsync();

                int processed = 0;
                int pendingUi = 0;

                // per-row callback: increment counters and dispatch UI in batches
                void OnRow()
                {
                    processed++;
                    var newPending = Interlocked.Increment(ref pendingUi);
                    if (newPending >= uiBatch)
                    {
                        // flush to UI thread without blocking
                        var toAdd = newPending;
                        try { System.Windows.Application.Current.Dispatcher.BeginInvoke(new Action(() => CurrentRow += toAdd)); }
                        catch { CurrentRow += toAdd; }
                        Interlocked.Add(ref pendingUi, -newPending);
                    }
                }

                await processor.ProcessRowsAsync(validateOnly, OnRow);

                // flush remaining UI increments
                var left = Interlocked.Exchange(ref pendingUi, 0);
                if (left > 0)
                {
                    try { System.Windows.Application.Current.Dispatcher.BeginInvoke(new Action(() => CurrentRow += left)); }
                    catch { CurrentRow += left; }
                }

                await processor.UpdateStatusAsync();

                var (total, passed, failed) = processor.GetCounts();

                // Insert summary with connection pooling
                try
                {
                    var cs = $"Data Source={dbPath};Cache=Shared";
                    using var sumConn = new Microsoft.Data.Sqlite.SqliteConnection(cs);
                    sumConn.Open();

                    // Enable WAL for concurrent writes and set busy timeout
                    using (var cmd = sumConn.CreateCommand())
                    {
                        cmd.CommandText = "PRAGMA journal_mode = WAL; PRAGMA synchronous = NORMAL; PRAGMA busy_timeout = 5000;";
                        cmd.ExecuteNonQuery();
                    }

                    using var sumCmd = sumConn.CreateCommand();
                    sumCmd.CommandText = @"CREATE TABLE IF NOT EXISTS ProcessingSummaries (
                        Id INTEGER PRIMARY KEY AUTOINCREMENT,
                        TableName TEXT,
                        Total INTEGER,
                        Successful INTEGER,
                        Failed INTEGER,
                        Timestamp TEXT
                    );";
                    sumCmd.ExecuteNonQuery();

                    using var insert = sumConn.CreateCommand();
                    insert.CommandText = "INSERT INTO ProcessingSummaries (TableName, Total, Successful, Failed, Timestamp) VALUES ($tname, $total, $succ, $fail, $ts);";
                    insert.Parameters.AddWithValue("$tname", t);
                    insert.Parameters.AddWithValue("$total", total);
                    insert.Parameters.AddWithValue("$succ", passed);
                    insert.Parameters.AddWithValue("$fail", failed);
                    insert.Parameters.AddWithValue("$ts", DateTime.Now.ToString("o"));
                    insert.ExecuteNonQuery();
                    sumConn.Close();
                }
                catch (Exception ex)
                {
                    Log(LogLevel.Warning, $"Could not write summary for {t}: {ex.Message}");
                }

                // update aggregate counters thread-safely and dispatch once per table
                TotalCount += total;
                PassedCount += passed;
                FailedCount += failed;

                Log(LogLevel.Ok, $"Finished {t}: {processed} rows, {passed} success, {failed} failed");
            }

            try
            {
                System.Windows.Application.Current.Dispatcher.Invoke(() =>
                {
                    StatusLabel = "Completed.";
                    IsCompleted = true;
                    ReportReady = true;
                    _reportPath = outputFolder;
                });
            }
            catch
            {
                StatusLabel = "Completed.";
                IsCompleted = true;
                ReportReady = true;
                _reportPath = outputFolder;
            }
            // Export per-table Excel reports into the output folder
            try
            {
                await ExportReportsFromDbAsync(dbPath, outputFolder);
                Log(LogLevel.Ok, "Reports exported.");
            }
            catch (Exception ex)
            {
                Log(LogLevel.Error, $"Failed to export reports: {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            Log(LogLevel.Error, $"Processing failed: {ex.Message}");
            StatusLabel = "Stopped.";
        }
        finally
        {
            IsRunning = false;
        }
    }

    /// <summary>Runs the job. Never throws: failures are logged so the view stays usable.</summary>
    public async Task RunAsync(IMigrationHandler handler, MigrationRunContext context)
    {
        BeginRun(context.Mode);
        var ct = context.CancellationToken;
        try
        {
            await InitializeAsync(handler, context, ct);
            var validation = await ValidateStepAsync(handler, ct);

            if (context.Mode == RunMode.ValidateOnly)
            {
                await ExportReportAsync(context, validation.Errors);
                ShowSummary(validation.TotalRows, validation.PassedRows, validation.TotalRows - validation.PassedRows);
            }
            else
            {
                var import = await ImportStepAsync(handler, ct);
                if (import.SkippedRows > 0)
                    await ExportReportAsync(context, import.SkippedErrors);
                ShowSummary(import.TotalRows, import.ImportedRows, import.SkippedRows);
            }

            StatusLabel = "Completed.";
            IsCompleted = true;
        }
        catch (FileNotFoundException ex)
        {
            Log(LogLevel.Error, ex.Message);
            StatusLabel = "Stopped.";
        }
        catch (IOException)
        {
            Log(LogLevel.Error, "Cannot open source file — it may be open in another application.");
            StatusLabel = "Stopped.";
        }
        catch (OperationCanceledException)
        {
            Log(LogLevel.Warning, "Run cancelled.");
            StatusLabel = "Cancelled.";
        }
        catch (Exception ex)
        {
            Log(LogLevel.Error, $"Unexpected error: {ex.Message}");
            StatusLabel = "Stopped with errors.";
        }
        finally
        {
            IsRunning = false;
        }
    }

    [RelayCommand]
    private void OpenReport()
    {
        if (_reportPath is null)
            return;
        Process.Start(new ProcessStartInfo { FileName = _reportPath, UseShellExecute = true });
    }

    private void BeginRun(RunMode mode)
    {
        Mode = mode;
        // Prepare log file in bin with timestamp
        try
        {
            var stamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            _logFilePath = Path.Combine(AppContext.BaseDirectory, $"runlog_{stamp}.txt");
            // create/overwrite
            File.WriteAllText(_logFilePath, $"Run started at {DateTime.Now:O}{Environment.NewLine}");
        }
        catch
        {
            _logFilePath = null;
        }

        // Set UI properties on dispatcher to ensure bindings update
        try
        {
            System.Windows.Application.Current.Dispatcher.Invoke(() =>
            {
                IsRunning = true;
                IsCompleted = false;
                ReportReady = false;
                _reportPath = null;
                NoticeBanner = null;
                CurrentRow = 0;
                TotalRows = 0;
                TotalCount = 0;
                PassedCount = 0;
                FailedCount = 0;
                LogLines.Clear();
                StatusLabel = "Reading source file…";
            });
        }
        catch
        {
            IsRunning = true;
            IsCompleted = false;
            ReportReady = false;
            _reportPath = null;
            NoticeBanner = null;
            CurrentRow = 0;
            TotalRows = 0;
            TotalCount = 0;
            PassedCount = 0;
            FailedCount = 0;
            LogLines.Clear();
            StatusLabel = "Reading source file…";
        }
    }

    private async Task InitializeAsync(IMigrationHandler handler, MigrationRunContext context, CancellationToken ct)
    {
        Log(LogLevel.Info, $"Opening {Path.GetFileName(context.SourceFilePath)}");
        await handler.InitAsync(context, ct);
        TotalRows = handler.RowCount;
        Log(LogLevel.Ok, $"Loaded {TotalRows} rows.");
    }

    private async Task<ValidationResult> ValidateStepAsync(IMigrationHandler handler, CancellationToken ct)
    {
        CurrentRow = 0;
        StatusLabel = "Validating rows…";
        var result = await handler.ValidateAsync(new Progress<int>(n => CurrentRow = n), ct);

        foreach (var error in result.Errors)
            Log(LogLevel.Error, $"Row {error.RowNumber} · {error.FieldName}: {error.Message}");
        Log(LogLevel.Ok, $"Validation complete: {result.PassedRows} of {result.TotalRows} rows passed.");
        return result;
    }

    private async Task<ImportResult> ImportStepAsync(IMigrationHandler handler, CancellationToken ct)
    {
        CurrentRow = 0;
        StatusLabel = "Importing records…";
        var result = await handler.ImportAsync(new Progress<int>(n => CurrentRow = n), ct);

        foreach (var error in result.SkippedErrors)
            Log(LogLevel.Error, $"Row {error.RowNumber} · {error.FieldName}: {error.Message}");
        Log(LogLevel.Ok, $"Import complete: {result.ImportedRows} imported, {result.SkippedRows} skipped.");
        return result;
    }

    private async Task ExportReportAsync(MigrationRunContext context, IReadOnlyList<RowError> errors)
    {
        try
        {
            StatusLabel = "Writing report…";
            await _reportExporter.ExportAsync(errors, context.ReportOutputPath);
            _reportPath = context.ReportOutputPath;
            ReportReady = true;
            Log(LogLevel.Info, $"Report written to {context.ReportOutputPath}");
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            Log(LogLevel.Error, $"Cannot write report: {ex.Message}");
        }
    }

    private void ShowSummary(int total, int passed, int failed)
    {
        TotalCount = total;
        PassedCount = passed;
        FailedCount = failed;
        if (failed > 0)
        {
            var action = Mode == RunMode.ValidateOnly ? "validated" : "imported";
            NoticeBanner = new NoticeBannerViewModel($"{failed} row(s) were not {action}. Open the report for details.");
        }
    }

    private void Log(LogLevel level, string message)
    {
        // Compose line
        var time = DateTime.Now;
        var timeText = time.ToString("HH:mm:ss");
        var line = new LogLine(timeText, message, level);

        // Ensure UI update happens on UI thread
        try
        {
            System.Windows.Application.Current.Dispatcher.Invoke(() =>
            {
                LogLines.Add(line);
                while (LogLines.Count > MaxLogLines)
                    LogLines.RemoveAt(0);
            });
        }
        catch
        {
            // If dispatcher unavailable, try direct add
            LogLines.Add(line);
        }

        // Append to log file if available
        try
        {
            if (!string.IsNullOrWhiteSpace(_logFilePath))
            {
                var text = $"[{time:yyyy-MM-dd HH:mm:ss}] [{level}] {message}{Environment.NewLine}";
                lock (_logFileLock)
                {
                    File.AppendAllText(_logFilePath, text);
                }
            }
        }
        catch
        {
            // ignore file write errors
        }
    }
}
