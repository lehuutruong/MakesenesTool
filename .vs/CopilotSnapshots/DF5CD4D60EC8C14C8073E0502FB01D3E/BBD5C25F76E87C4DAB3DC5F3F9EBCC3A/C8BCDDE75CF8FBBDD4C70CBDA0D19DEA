using System.Globalization;
using System.Windows;
using System.Windows.Data;

namespace MakesenesTool.Converters;

/// <summary>Two-way bridge between an enum value and a RadioButton's IsChecked. The parameter is the enum member name.</summary>
public class EnumMatchConverter : IValueConverter
{
    /// <inheritdoc/>
    public object? Convert(object? value, Type targetType, object? parameter, CultureInfo culture)
        => value?.ToString() == parameter?.ToString();

    /// <inheritdoc/>
    public object? ConvertBack(object? value, Type targetType, object? parameter, CultureInfo culture)
    {
        if (value is true && parameter is string name)
            return Enum.Parse(targetType, name);
        return Binding.DoNothing;
    }
}
