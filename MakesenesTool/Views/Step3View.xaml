<UserControl x:Class="MakesenesTool.Views.Step3View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Step 3, Running and Results" FontSize="18" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} / {1} rows">
                        <Binding Path="CurrentRow"/>
                        <Binding Path="TotalRows"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ProgressBar Height="8" Margin="0,4,0,0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>

        <!-- Log -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="8" Margin="0,0,0,12">
            <ListBox ItemsSource="{Binding LogLines}" BorderThickness="0" FontFamily="Consolas" MinHeight="180">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Timestamp}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Message}"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Summary cards -->
        <Grid Grid.Row="3" Margin="0,0,0,12"
              Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Card -->
            <Border Grid.Column="0" Padding="16" CornerRadius="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{Binding TotalCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextAlignment="Center"/>
                    <TextBlock Text="Total" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Passed/Imported Card -->
            <Border Grid.Column="1" Padding="16" CornerRadius="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="{Binding PassedCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}" TextAlignment="Center"/>
                    <TextBlock Text="{Binding PassedLabel}" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Failed/Skipped Card -->
            <Border Grid.Column="2" Padding="16" CornerRadius="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding FailedCount}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" TextAlignment="Center"/>
                    <TextBlock Text="{Binding FailedLabel}" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notice banner -->
        <Border Grid.Row="4" Padding="12" CornerRadius="6" Margin="0,0,0,12"
                Background="{StaticResource WarningBackgroundBrush}"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding NoticeBanner.Message}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
        </Border>

        <!-- Action -->
        <Button Grid.Row="5" Content="Open report" Command="{Binding OpenReportCommand}"
                IsEnabled="{Binding CanOpenReport}" HorizontalAlignment="Right"
                Style="{StaticResource PrimaryButton}"/>
    </Grid>
</UserControl>
