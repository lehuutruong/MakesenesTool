<UserControl x:Class="MakesenesTool.Views.Step1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Step 1, Source Data Selection" FontSize="18" Foreground="{StaticResource TextBrush}"/>
            <Border Width="16" Height="16" CornerRadius="8" BorderBrush="{StaticResource MutedBrush}"
                    BorderThickness="1" Margin="8,2,0,0">
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <RadioButton Content="Local scope" IsChecked="True" GroupName="Scope"
                     Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

        <Border Margin="24,0,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock Text="Source folder" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding State.SourceFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                    <Button Grid.Column="1" Content="Browse" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0" Padding="14,5"/>
                </Grid>

                <!--<TextBlock Text="Category" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,4"/>-->
                <!--<ListBox ItemsSource="{Binding State.Categories}" SelectedItem="{Binding State.SelectedCategory}"
                         BorderThickness="0" Height="130">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="4,3" Foreground="{StaticResource TextBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>-->
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
